# Variables d'environnement — à définir sur l'hébergeur (Railway/Render/Fly), PAS à committer.

# Base de données : en production, un fichier sur le disque persistant (volume monté sur /data)
DATABASE_URL="file:/data/apex.db"

# Secret de session (générer une longue chaîne aléatoire : openssl rand -hex 32)
AUTH_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# Compte administrateur créé automatiquement au 1er démarrage
ADMIN_EMAIL="patron@exemple.lu"
ADMIN_PASSWORD="UnMotDePasseFort!"
ADMIN_NOM="Administrateur"

# Dossier des uploads sur le disque persistant (par défaut /data/uploads)
UPLOADS_DIR="/data/uploads"

# --- En local (développement), utilise plutôt un fichier .env avec : ---
# DATABASE_URL="file:./dev.db"
# AUTH_SECRET="secret-de-dev"
